<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:text="Chat Test Panel"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"/>

    <!-- Hien UID hien tai -->
    <TextView
        android:id="@+id/tvCurrentUid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0F0F0"
        android:padding="12dp"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <!-- Nhap UID nguoi kia -->
    <EditText
        android:id="@+id/etOtherUserId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Paste UID nguoi kia vao day"
        android:textSize="14sp"
        android:padding="12dp"
        android:background="#F5F5F5"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnStartChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bat dau chat"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnSwitchUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Switch sang user khac"
        android:backgroundTint="#FF9800"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Huong dan: \n1. Mo app, copy UID\n2. Bam Switch User\n3. Dan UID cu vao o tren\n4. Bam Bat dau chat"
        android:textSize="12sp"
        android:textColor="#888"
        android:layout_marginTop="32dp"
        android:gravity="center"/>

</LinearLayout>