<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/white"
    app:cardBackgroundColor="@color/white"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Avatar -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/logo_tran"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_circle"/>

                <!-- Name + time -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thảo Hương"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 giờ trước "
                        android:textSize="12sp"
                        android:textColor="#888"/>
                </LinearLayout>

                <!-- Status -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thất lạc"
                    android:textStyle="bold"
                    android:textColor="@color/primary_red"
                    android:padding="6dp"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mất iPhone 15 Pro màu xanh"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp"/>

            <!-- Description -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mất điện thoại tại cafe The Coffee House..."
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <!-- Image -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPostImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>

            <!-- Location + time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quận 1, TP.HCM - "
                    android:textSize="12sp"
                    android:textColor="#666"/>

                <TextView
                    android:id="@+id/tvTimePerfrom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14:30 hôm nay"
                    android:textSize="12sp"
                    android:textColor="#666"/>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEE"
                android:layout_marginVertical="8dp"/>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <!-- Share -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Chia sẻ"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:paddingHorizontal="6dp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/primary_blue"
                    android:textColor="@android:color/white"/>

                <Space
                    android:layout_width="6dp"
                    android:layout_height="wrap_content"/>

                <!-- Chat -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChat"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Nhắn tin"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:paddingHorizontal="6dp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/primary_blue"
                    android:textColor="@android:color/white"/>

                <Space
                    android:layout_width="6dp"
                    android:layout_height="wrap_content"/>

                <!-- Edit -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Sửa"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:paddingHorizontal="6dp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/primary_blue"
                    android:textColor="@android:color/white"/>

                <Space
                    android:layout_width="6dp"
                    android:layout_height="wrap_content"/>

                <!-- Delete -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Xóa"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:paddingHorizontal="6dp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@android:color/holo_red_dark"
                    android:textColor="@android:color/white"/>

            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/primary_grey"
            android:gravity="bottom"
            />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>