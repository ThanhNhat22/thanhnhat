<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/logo"
            android:contentDescription="Logo"
            android:scaleType="fitCenter" />

        <!-- Tên app -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Góc Tìm Đồ"
            android:textColor="#1565F9"
            android:textStyle="bold"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp" />

        <!-- Ảnh minh họa -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="430dp"
            android:layout_marginTop="40dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/onboarding_image"
                android:scaleType="centerCrop"
                android:contentDescription="Onboarding Image" />

        </androidx.cardview.widget.CardView>

        <!-- Text mô tả -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tìm lại đồ thất lạc, Kết nối cộng đồng"
            android:textColor="#2F3542"
            android:textSize="20sp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:layout_marginTop="48dp" />

        <!-- Gạch xanh -->
        <View
            android:layout_width="80dp"
            android:layout_height="6dp"
            android:background="#1565F9"
            android:layout_marginTop="12dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <!-- Button -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="BẮT ĐẦU  →"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0450D8"
            android:layout_marginBottom="28dp" />

        <!-- Indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <View
                android:layout_width="38dp"
                android:layout_height="8dp"
                android:background="#1565F9"
                android:layout_marginEnd="8dp" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="#D6D9DE"
                android:layout_marginEnd="8dp" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="#D6D9DE" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>