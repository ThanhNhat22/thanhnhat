<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F9"

    android:clipToPadding="false"
    android:paddingBottom="140dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:baselineAligned="false">

        <!-- TYPE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/post_type"
            android:textStyle="bold"/>

        <!-- SEGMENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_segment"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/layoutLost"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_segment_item">

                <TextView
                    android:id="@+id/tvLost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lost"
                    android:textColor="#FFF"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutFound"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_segment_item">

                <TextView
                    android:id="@+id/tvFound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/found"
                    android:textColor="#666"/>
            </LinearLayout>

        </LinearLayout>

        <!-- TITLE -->
        <EditText
            android:id="@+id/edtTitle"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:hint="@string/title_hint"
            android:background="@drawable/bg_input"
            android:padding="16dp"/>

        <!-- DESCRIPTION -->
        <EditText
            android:id="@+id/edtDescription"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="16dp"
            android:hint="@string/description_hint"
            android:gravity="top"
            android:background="@drawable/bg_input"
            android:padding="16dp"/>

        <!-- LOCATION -->
        <EditText
            android:id="@+id/edtLocation"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:hint="@string/location_hint"
            android:background="@drawable/bg_input"
            android:padding="16dp"
            android:focusable="false"
            android:clickable="false"/>

        <!-- PICK LOCATION -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickLocation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="📍 Chọn vị trí trên bản đồ"
            android:textAllCaps="false"
            android:textColor="#0A63FF"
            app:strokeColor="#0A63FF"
            app:cornerRadius="12dp"/>

        <!-- COORDS -->
        <LinearLayout
            android:id="@+id/layoutCoords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍"/>

            <TextView
                android:id="@+id/tvLocationCoords"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#0A63FF"
                android:maxLines="1"
                android:ellipsize="end"/>

            <ImageView
                android:id="@+id/btnClearLocation"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"/>
        </LinearLayout>

        <!-- IMAGES -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvImages"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="20dp"/>

        <!-- BUTTONS (KHÔNG BỊ CHE NỮA) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textAllCaps="false"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPost"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="2"
                android:text="@string/post"
                android:textAllCaps="false"
                android:backgroundTint="#0A63FF"
                android:textColor="#FFF"/>
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>